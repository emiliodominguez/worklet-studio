{
	"name": "ripple-worklet",
	"version": "0.1.0",
	"description": "Liquid interference rings and luminous wavefronts.",
	"type": "module",
	"main": "worklet.js",
	"exports": {
		".": "./worklet.js",
		"./worklet.js": "./worklet.js",
		"./worklet.min.js": "./worklet.min.js",
		"./register": {
			"types": "./dist/register.d.ts",
			"import": "./dist/register.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"worklet.js",
		"worklet.min.js",
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./worklet.js",
		"./worklet.min.js"
	],
	"author": "Emilio Dom\u00ednguez",
	"license": "MIT",
	"keywords": [
		"css",
		"houdini",
		"worklet",
		"generative-art",
		"ripple"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.mjs",
		"prepack": "npm run build",
		"dev": "node ../../scripts/build-package.mjs --watch"
	},
	"devDependencies": {
		"@worklet-studio/core": "*"
	}
}
