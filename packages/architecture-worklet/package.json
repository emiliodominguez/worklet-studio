{
	"name": "architecture-worklet",
	"version": "0.1.0",
	"description": "A three-dimensional concrete atrium painted as a CSS background, with reflections, sunlight and an explorable camera.",
	"type": "module",
	"main": "worklet.js",
	"exports": {
		".": "./worklet.js",
		"./worklet.js": "./worklet.js",
		"./worklet.min.js": "./worklet.min.js",
		"./register": {
			"types": "./dist/register.d.ts",
			"import": "./dist/register.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"worklet.js",
		"worklet.min.js",
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./worklet.js",
		"./worklet.min.js"
	],
	"author": "Emilio Domínguez",
	"license": "MIT",
	"keywords": [
		"css",
		"houdini",
		"worklet",
		"architecture",
		"3d",
		"procedural"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.mjs",
		"prepack": "npm run build",
		"dev": "node ../../scripts/build-package.mjs --watch"
	},
	"devDependencies": {
		"@worklet-studio/core": "*"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/emiliodominguez/worklet-studio.git",
		"directory": "packages/architecture-worklet"
	},
	"homepage": "https://emiliodominguez.github.io/worklet-studio/atrium.html",
	"bugs": {
		"url": "https://github.com/emiliodominguez/worklet-studio/issues"
	}
}
