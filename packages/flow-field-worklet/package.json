{
	"name": "flow-field-worklet",
	"version": "0.1.0",
	"description": "Animated generative flow fields and magnetic streamlines.",
	"type": "module",
	"main": "worklet.js",
	"exports": {
		".": "./worklet.js",
		"./worklet.js": "./worklet.js",
		"./worklet.min.js": "./worklet.min.js",
		"./register": {
			"types": "./dist/register.d.ts",
			"import": "./dist/register.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"worklet.js",
		"worklet.min.js",
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./worklet.js",
		"./worklet.min.js"
	],
	"author": "Emilio Domínguez",
	"license": "MIT",
	"keywords": [
		"css",
		"houdini",
		"worklet",
		"generative-art",
		"flow-field"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.mjs",
		"prepack": "npm run build",
		"dev": "node ../../scripts/build-package.mjs --watch"
	},
	"devDependencies": {
		"@worklet-studio/core": "*"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/emiliodominguez/worklet-studio.git",
		"directory": "packages/flow-field-worklet"
	},
	"homepage": "https://emiliodominguez.github.io/worklet-studio/#effect=flow-field",
	"bugs": {
		"url": "https://github.com/emiliodominguez/worklet-studio/issues"
	}
}
