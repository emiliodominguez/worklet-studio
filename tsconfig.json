{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"*-worklet/register": ["./packages/*-worklet/src/register.ts"]
		}
	},
	"include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
