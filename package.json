{
	"name": "worklet-studio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@12.1.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "turbo run dev --concurrency=16",
		"build": "turbo run build",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts tests/*.test.mjs",
		"test:browser": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run build && npm run typecheck && npm run test && npm run test:browser && npm run codepens:check && npm run format:check",
		"pack:check": "npm run build && node scripts/check-packages.mjs",
		"release:dry-run": "npm run check && node scripts/release.mjs --dry-run",
		"release:publish": "npm run check && node scripts/release.mjs --publish",
		"codepens:prepare": "node scripts/codepens/prepare.mjs",
		"codepens:publish": "npm run codepens:prepare && node scripts/codepens/publish.mjs --publish",
		"codepens:check": "npm run codepens:prepare && node scripts/codepens/publish.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.5",
		"esbuild": "0.28.2",
		"prettier": "3.9.10",
		"sass": "1.106.1",
		"turbo": "2.11.10",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/emiliodominguez/worklet-studio.git"
	},
	"homepage": "https://emiliodominguez.github.io/worklet-studio/",
	"bugs": {
		"url": "https://github.com/emiliodominguez/worklet-studio/issues"
	}
}
